      <div className="max-w-7xl mx-auto px-6">
        <div className="text-center mb-16">
          <h2 className="text-primary font-medium tracking-[0.2em] uppercase text-sm mb-4">Immersion</h2>
          <h3 className="text-4xl md:text-5xl mb-6">Notre Ambiance</h3>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {galleryImages.map((img, idx) => (
            <div 
              key={idx} 
              className={cn(
                "relative overflow-hidden rounded-2xl group h-80",
                idx === 0 || idx === 3 ? "lg:col-span-2" : ""
              )}
            >
              <Image
                src={img.imageUrl}
                alt={img.description}
                fill
                className="object-cover group-hover:scale-110 transition-transform duration-700"
